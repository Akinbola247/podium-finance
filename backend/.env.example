INJECTIVE_EXPLORER_URL=https://sentry.exchange.grpc-web.injective.network/api/explorer/v1
# Local: ./podium.db
# Render: attach 1GB disk at /var/data, then set:
# DATABASE_URL=sqlite:////var/data/podium.db
DATABASE_URL=sqlite:///./podium.db
REDIS_URL=redis://localhost:6379/0
REDIS_ALERTS_CHANNEL=podium:live_alerts
POLL_INTERVAL_SECONDS=12
GLOBAL_TX_BATCH_SIZE=40
ACCOUNT_TX_BACKFILL_LIMIT=80
MIN_NOTIONAL_USD=25
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
